// 18. Overview Chart Renderers
function renderAllCharts() {
  if (typeof Chart === 'undefined') return;

  const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
  const textColor = isDark ? '#94a3b8' : '#475569';
  const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';

  Chart.defaults.color = textColor;
  Chart.defaults.font.family = "'IBM Plex Sans Thai', sans-serif";

  renderExecutiveAchievementChart(gridColor, textColor);
}

function renderExecutiveAchievementChart(gridColor, textColor) {
  const canvas = document.getElementById('chart-strategic-achievement');
  if (!canvas) return;

  if (AppState.charts.strategic) AppState.charts.strategic.destroy();

  const labels = ['ยุทธศาสตร์ 1 (PP&P)', 'ยุทธศาสตร์ 2 (Service)', 'ยุทธศาสตร์ 3 (People)', 'ยุทธศาสตร์ 4 (Governance)', 'ยุทธศาสตร์ 5 (Consumer)'];
  const passRates = [1, 2, 3, 4, 5].map(num => {
    const kpis = AppState.kpiData.filter(k => k.strategy.includes(`ยุทธศาสตร์ที่ ${num}`));
    let pass = 0;
    kpis.forEach(k => {
      if (evaluateStatus(k, '68').status === 'pass') pass++;
    });
    return kpis.length > 0 ? ((pass / kpis.length) * 100).toFixed(1) : 0;
  });

  AppState.charts.strategic = new Chart(canvas, {
    type: 'bar',
    data: {
      labels: labels,
      datasets: [{
        label: '% ความสำเร็จปี 2568',
        data: passRates,
        backgroundColor: ['#0ea5e9', '#10b981', '#8b5cf6', '#f59e0b', '#ec4899'],
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: { beginAtZero: true, max: 100, grid: { color: gridColor } },
        x: { grid: { display: false } }
      },
      plugins: {
        legend: { display: false }
      }
    }
  });
}

// 19. Google Sheets Live GViz Fetching
async function fetchLiveData(isManual = false) {
  showSyncIndicator('syncing', 'กำลังซิงค์ Google Sheet...');

  try {
    let newData = null;

    if (AppState.gasEndpoint) {
      const res = await fetch(AppState.gasEndpoint);
      const json = await res.json();
      if (json && json.data) newData = json.data;
    }

    if (!newData) {
      const gvizUrl = `https://docs.google.com/spreadsheets/d/${AppState.sheetId}/gviz/tq?tqx=out:json&gid=${AppState.gid}`;
      const response = await fetch(gvizUrl);
      const text = await response.text();
      const jsonStr = text.substring(text.indexOf('{'), text.lastIndexOf('}') + 1);
      const gvizData = JSON.parse(jsonStr);

      if (gvizData && gvizData.table && gvizData.table.rows) {
        const rows = gvizData.table.rows;
        let headerIdx = -1;
        for (let i = 0; i < rows.length; i++) {
          const val = rows[i].c[0]?.v?.toString().trim();
          if (val === 'KPI_ID') { headerIdx = i; break; }
        }
        if (headerIdx === -1) headerIdx = 0;

        const kpis = [];
        for (let r = headerIdx + 1; r < rows.length; r++) {
          const c = rows[r].c;
          if (!c || !c[0] || !c[0].v || !c[0].v.toString().startsWith('KPI')) continue;

          kpis.push({
            id: c[0]?.v?.toString().trim() || '',
            order: c[1]?.v?.toString().trim() || '',
            name: c[2]?.v?.toString().trim() || '',
            strategy: c[3]?.v?.toString().trim() || '',
            objective: c[4]?.v?.toString().trim() || '',
            unit: c[5]?.v?.toString().trim() || '',
            direction: c[6]?.v?.toString().trim() || 'ยิ่งมากยิ่งดี',
            target66: c[7]?.f || c[7]?.v || null,
            actual66: c[8]?.f || c[8]?.v || null,
            target67: c[9]?.f || c[9]?.v || null,
            actual67: c[10]?.f || c[10]?.v || null,
            target68: c[11]?.f || c[11]?.v || null,
            actual68: c[12]?.f || c[12]?.v || null,
            target69: c[13]?.f || c[13]?.v || null,
            actual69: c[14]?.f || c[14]?.v || null,
            target70: c[15]?.f || c[15]?.v || null,
            lineage: c[16]?.v?.toString().trim() || '',
            notes: c[17]?.v?.toString().trim() || ''
          });
        }
        if (kpis.length > 0) newData = kpis;
      }
    }

    if (newData && newData.length > 0) {
      const overrides = JSON.parse(localStorage.getItem('kpi_local_overrides') || '{}');
      AppState.kpiData = newData.map(k => overrides[k.id] ? { ...k, ...overrides[k.id] } : k);
      AppState.lastSyncTime = new Date();
      showSyncIndicator('success', `อัปเดตสด: ${AppState.lastSyncTime.toLocaleTimeString('th-TH')}`);
      renderApp();
    } else {
      showSyncIndicator('success', `ใช้ข้อมูลล่าสุด (${AppState.kpiData.length} ตัวชี้วัด)`);
    }
  } catch (err) {
    console.warn('Live fetch warning:', err);
    showSyncIndicator('error', 'ออฟไลน์ / ใช้ข้อมูลแคช');
  }
}

function showSyncIndicator(status, message) {
  const pill = document.getElementById('sync-status-pill');
  if (!pill) return;
  const dot = pill.querySelector('.pulse-dot');
  const text = pill.querySelector('.sync-text');

  if (dot) {
    dot.className = `pulse-dot ${status === 'syncing' ? 'syncing' : status === 'error' ? 'error' : ''}`;
  }
  if (text) text.textContent = message;
}

function setupAutoSync() {
  if (AppState.syncTimer) clearInterval(AppState.syncTimer);
  if (AppState.autoSyncInterval > 0) {
    AppState.syncTimer = setInterval(() => {
      fetchLiveData(false);
    }, AppState.autoSyncInterval * 1000);
  }
}

function saveSettings() {
  const gasInput = document.getElementById('setting-gas-url');
  const intervalSelect = document.getElementById('setting-sync-interval');

  if (gasInput) {
    AppState.gasEndpoint = gasInput.value.trim();
    localStorage.setItem('kpi_gas_endpoint', AppState.gasEndpoint);
  }

  if (intervalSelect) {
    AppState.autoSyncInterval = parseInt(intervalSelect.value, 10);
    localStorage.setItem('kpi_sync_interval', AppState.autoSyncInterval.toString());
    setupAutoSync();
  }

  alert('บันทึกการตั้งค่า Google Sheets เรียบร้อยแล้ว');
  fetchLiveData(true);
}
