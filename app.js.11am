            <div class="modal-alert-desc">${kpi.lineage || kpi.notes || 'ตัวชี้วัดต่อเนื่องตามกรอบยุทธศาสตร์สาธารณสุข 2566–2570'}</div>
          </div>
        </div>

        <div class="modal-chart-card">
          <div class="modal-chart-header">
            <span class="modal-chart-title-text">แนวโน้มผลการดำเนินงานจริง vs เป้าหมาย (2566–2570)</span>
            <span class="badge-blue-soft">${kpi.unit} (${kpi.direction})</span>
          </div>
          <div class="modal-chart-canvas-wrapper">
            <canvas id="chart-modal-kpi"></canvas>
          </div>
          <div class="modal-chart-custom-legend">
            <div class="legend-item"><span class="legend-line-actual"></span> <span>ผลงานจริง (Actual)</span></div>
            <div class="legend-item"><span class="legend-line-target"></span> <span>เป้าหมาย (Target)</span></div>
            <div class="legend-item"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#10b981;"></span> <span>ผ่านเกณฑ์</span></div>
            <div class="legend-item"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#ef4444;"></span> <span>ไม่ผ่านเกณฑ์</span></div>
          </div>
        </div>
      </div>

      <!-- Right Column: Table & AI Strategic Panel -->
      <div class="modal-grid-right">
        <div class="modal-section-title">📊 ตารางสรุปผลงานและเป้าหมาย 5 ปี (พ.ศ. 2566–2570)</div>
        <div class="modal-history-table-wrap">
          <table class="modal-history-table">
            <thead>
              <tr>
                <th>รายการ</th>
                <th>2566</th>
                <th>2567</th>
                <th>2568</th>
                <th>เป้า 2569</th>
                <th>เป้า 2570</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="color:#0f172a; font-weight:700;">เป้าหมาย</td>
                <td style="color:#0f172a;">${kpi.target66 || '-'}</td>
                <td style="color:#0f172a;">${kpi.target67 || '-'}</td>
                <td style="color:#0f172a;">${kpi.target68 || '-'}</td>
                <td style="color:#0f172a; font-weight:700;">${kpi.target69 || '-'}</td>
                <td style="color:#0f172a; font-weight:700;">${kpi.target70 || '-'}</td>
              </tr>
              <tr>
                <td style="color:#0f172a; font-weight:700;">ผลงานจริง</td>
                <td>${kpi.actual66 !== null ? kpi.actual66 : '-'}</td>
                <td>${formatActualWithColor(kpi, '67')}</td>
                <td>${formatActualWithColor(kpi, '68')}</td>
                <td>${kpi.actual69 !== null ? formatActualWithColor(kpi, '69') : '-'}</td>
                <td>-</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- AI Strategic Intelligence Panel -->
        <div class="ai-intelligence-panel">
          <div class="ai-panel-header">
            <div class="ai-panel-title">
              <span class="ai-sparkle-icon">🤖</span>
              <div>
                <strong>AI Prediction & Strategic Reasoning</strong>
