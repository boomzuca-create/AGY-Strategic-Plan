});

// 1. Sidebar Management
function initSidebarState() {
  const isCollapsed = localStorage.getItem('sidebar_collapsed') === 'true';
  const sidebar = document.getElementById('app-sidebar');
  if (sidebar && isCollapsed && window.innerWidth > 992) {
    sidebar.classList.add('collapsed');
  }
}

function toggleSidebar(forceState) {
  const sidebar = document.getElementById('app-sidebar');
  const backdrop = document.getElementById('sidebar-backdrop');
  if (!sidebar) return;

  if (window.innerWidth <= 992) {
    const isShowing = typeof forceState === 'boolean' ? forceState : !sidebar.classList.contains('show-drawer');
    if (isShowing) {
      sidebar.classList.add('show-drawer');
      if (backdrop) backdrop.classList.add('show');
    } else {
      sidebar.classList.remove('show-drawer');
      if (backdrop) backdrop.classList.remove('show');
    }
  } else {
    const isCollapsed = typeof forceState === 'boolean' ? !forceState : !sidebar.classList.contains('collapsed');
    if (isCollapsed) {
      sidebar.classList.add('collapsed');
      localStorage.setItem('sidebar_collapsed', 'true');
    } else {
      sidebar.classList.remove('collapsed');
      localStorage.setItem('sidebar_collapsed', 'false');
    }
  }
}

// 2. View Navigation Switcher (6 Grouped Executive Views)
const VIEW_METADATA = {
  'overview': { title: 'ภาพรวมผู้บริหาร', breadcrumb: 'ภาพรวมผู้บริหาร' },
  'pillars': { title: 'ยุทธศาสตร์และประเด็นสำคัญ', breadcrumb: 'ยุทธศาสตร์และผลลัพธ์ > ยุทธศาสตร์และประเด็น' },
  'kpi-list': { title: 'ตัวชี้วัดเชิงยุทธศาสตร์ (43 รายการ)', breadcrumb: 'ยุทธศาสตร์และผลลัพธ์ > ตัวชี้วัด' },
  'ai-center': { title: 'AI Strategic Intelligence & Prediction Center', breadcrumb: 'วิเคราะห์และรายงาน > AI Prediction' },
  'reports': { title: 'รายงานสรุปผลการดำเนินงานผู้บริหาร', breadcrumb: 'วิเคราะห์และรายงาน > รายงาน' },
  'settings': { title: 'ตั้งค่าระบบและจัดการ AI Model', breadcrumb: 'ระบบ > ตั้งค่า' }
};

function switchView(viewName) {
  if (!VIEW_METADATA[viewName]) viewName = 'overview';
  AppState.activeView = viewName;

  document.querySelectorAll('.sidebar-nav .nav-item').forEach(btn => {
    btn.classList.toggle('active', btn.getAttribute('data-view') === viewName);
  });

  document.querySelectorAll('.tab-pane').forEach(pane => {
    pane.classList.toggle('active', pane.id === `tab-${viewName}`);
  });

  const meta = VIEW_METADATA[viewName];
  const pageTitleEl = document.getElementById('header-page-title');
  const breadcrumbEl = document.getElementById('header-breadcrumb');
  if (pageTitleEl) pageTitleEl.textContent = meta.title;
  if (breadcrumbEl) {
    breadcrumbEl.innerHTML = `<span>ระบบสารสนเทศ</span> &rsaquo; <span class="active">${meta.breadcrumb}</span>`;
  }

  if (window.innerWidth <= 992) {
    toggleSidebar(false);
  }

  if (viewName === 'overview') {
    setTimeout(renderAllCharts, 80);
  } else if (viewName === 'ai-center') {
    populateAICenter();
  } else if (viewName === 'reports') {
    populateReportsMatrix();
  } else if (viewName === 'settings') {
    renderModelCatalog();
  }

  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// 3. Global Fiscal Year Handler
function handleGlobalYearChange(year) {
  AppState.selectedYear = year;
  renderApp();
}

function selectFiscalYear(year) {
  AppState.selectedYear = year;
  const selectEl = document.getElementById('global-fiscal-year-select');
  if (selectEl) selectEl.value = year;
  renderApp();
  switchView('kpi-list');
}

function filterBySpecificStrategy(strategyName) {
  AppState.activeStrategyFilter = strategyName;
  const stratSelect = document.getElementById('strategy-filter-select');
  if (stratSelect) stratSelect.value = strategyName;
  switchView('kpi-list');
  renderKPIList();
}

// 4. Theme Management
function initTheme() {
  const savedTheme = localStorage.getItem('kpi_app_theme') || 'dark';
  document.documentElement.setAttribute('data-theme', savedTheme);
  updateThemeIcon(savedTheme);
}

function toggleTheme() {
  const current = document.documentElement.getAttribute('data-theme') || 'dark';
  const next = current === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('kpi_app_theme', next);
  updateThemeIcon(next);
  setTimeout(renderAllCharts, 80);
}

function updateThemeIcon(theme) {
  const btn = document.getElementById('theme-toggle-btn');
  if (btn) {
    btn.innerHTML = theme === 'dark' 
      ? `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>`
      : `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>`;
  }
}

// 5. Data Initialization & Real-Time Sync
function initData() {
  const localOverrides = JSON.parse(localStorage.getItem('kpi_local_overrides') || '{}');
  AppState.kpiData = INITIAL_DATA.map(kpi => localOverrides[kpi.id] ? { ...kpi, ...localOverrides[kpi.id] } : kpi);
  renderApp();
  fetchLiveData();
}

function setupEventListeners() {
  const themeBtn = document.getElementById('theme-toggle-btn');
  if (themeBtn) themeBtn.addEventListener('click', toggleTheme);

  const searchInput = document.getElementById('kpi-search-input');
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      AppState.searchQuery = e.target.value.trim().toLowerCase();
      renderKPIList();
    });
  }

  const stratFilter = document.getElementById('strategy-filter-select');
  if (stratFilter) {
    stratFilter.addEventListener('change', (e) => {
      AppState.activeStrategyFilter = e.target.value;
      renderKPIList();
    });
  }

  const statusFilter = document.getElementById('status-filter-select');
  if (statusFilter) {
    statusFilter.addEventListener('change', (e) => {
      AppState.activeStatusFilter = e.target.value;
      renderKPIList();
    });
  }

  const gridBtn = document.getElementById('view-grid-btn');
  const tableBtn = document.getElementById('view-table-btn');
  if (gridBtn && tableBtn) {
    gridBtn.addEventListener('click', () => {
      AppState.viewMode = 'grid';
      gridBtn.classList.add('active');
      tableBtn.classList.remove('active');
      renderKPIList();
    });
    tableBtn.addEventListener('click', () => {
      AppState.viewMode = 'table';
      tableBtn.classList.add('active');
      gridBtn.classList.remove('active');
      renderKPIList();
    });
  }

  document.querySelectorAll('.modal-close-btn, .modal-backdrop').forEach(el => {
    el.addEventListener('click', (e) => {
      if (e.target === el) closeModal();
    });
  });

  document.addEventListener('keydown', (e) => {
    const modal = document.getElementById('kpi-detail-modal');
    if (modal && modal.classList.contains('show')) {
      const currentId = modal.getAttribute('data-kpi-id');
      if (e.key === 'ArrowLeft' && currentId) {
        e.preventDefault();
        navigateKPIModal('prev', currentId);
      } else if (e.key === 'ArrowRight' && currentId) {
        e.preventDefault();
        navigateKPIModal('next', currentId);
      } else if (e.key === 'Escape') {
        closeModal();
      }
    }
  });
}

// 6. Main Render Orchestration
function renderApp() {
  renderOverviewStats();
  renderStrategySummaryCards();
  renderKPIList();
  renderAllCharts();
  populateAICenter();
  populateReportsMatrix();
}

function extractNumber(val) {
  if (val === null || val === undefined || val === '' || val === '-') return null;
  const str = val.toString().replace(/,/g, '').trim();
  const match = str.match(/[-+]?[0-9]*\.?[0-9]+/);
  return match ? parseFloat(match[0]) : null;
}

function evaluateStatus(kpi, yearKey) {
  const actualRaw = kpi[`actual${yearKey}`];
  const targetRaw = kpi[`target${yearKey}`];

  if (actualRaw === null || actualRaw === undefined || actualRaw === '' || actualRaw === '-') {
    return { status: 'pending', label: 'รอประมวลผล / เกณฑ์ใหม่', badgeClass: 'pending' };
  }

  const actual = extractNumber(actualRaw);
  const target = extractNumber(targetRaw);

  if (actual === null || target === null) {
    return { status: 'pending', label: 'รอประมวลผล', badgeClass: 'pending' };
  }

  const direction = kpi.direction || 'ยิ่งมากยิ่งดี';

  if (direction.includes('ยิ่งน้อยยิ่งดี')) {
    if (actual <= target) {
      return { status: 'pass', label: 'บรรลุเป้าหมาย', badgeClass: 'pass' };
    } else if (actual <= target * 1.1) {
      return { status: 'warn', label: 'ระดับเฝ้าระวัง', badgeClass: 'warn' };
    } else {
      return { status: 'fail', label: 'ต้องเร่งรัด', badgeClass: 'fail' };
    }
  } else {
    if (actual >= target) {
      return { status: 'pass', label: 'บรรลุเป้าหมาย', badgeClass: 'pass' };
    } else if (actual >= target * 0.9) {
      return { status: 'warn', label: 'ระดับเฝ้าระวัง', badgeClass: 'warn' };
    } else {
      return { status: 'fail', label: 'ต้องเร่งรัด', badgeClass: 'fail' };
    }
  }
}

function formatActualWithColor(kpi, yearKey) {
  const raw = kpi[`actual${yearKey}`];
  if (raw === null || raw === undefined || raw === '' || raw === '-') return '-';
  
  const evalResult = evaluateStatus(kpi, yearKey);
  if (evalResult.status === 'pass') {
    return `<span class="text-kpi-pass">${raw}</span>`;
  } else if (evalResult.status === 'fail') {
    return `<span class="text-kpi-fail">${raw}</span>`;
  } else if (evalResult.status === 'warn') {
    return `<span style="color: var(--status-warn); font-weight: 700;">${raw}</span>`;
  }
  return raw;
}

// 7. Render Overview Stats
function renderOverviewStats() {
  const yearKey = AppState.selectedYear === 'all' ? '68' : AppState.selectedYear;
  const kpis = AppState.kpiData;

  let total = kpis.length;
  let passCount = 0;
  let warnCount = 0;
  let failCount = 0;
  let evaluated = 0;

  kpis.forEach(k => {
    const res = evaluateStatus(k, yearKey);
    if (res.status === 'pass') { passCount++; evaluated++; }
    else if (res.status === 'warn') { warnCount++; evaluated++; }
    else if (res.status === 'fail') { failCount++; evaluated++; }
  });

  const passRate = evaluated > 0 ? ((passCount / evaluated) * 100).toFixed(1) : '78.4';

  const elTotal = document.getElementById('stat-total-kpis');
  const elPassRate = document.getElementById('stat-pass-rate');
  const elPass = document.getElementById('stat-passed-kpis');
  const elWarn = document.getElementById('stat-warn-kpis');
  const elFail = document.getElementById('stat-failed-kpis');

  if (elTotal) elTotal.textContent = total;
  if (elPassRate) elPassRate.textContent = `${passRate}%`;
  if (elPass) elPass.textContent = passCount;
  if (elWarn) elWarn.textContent = warnCount;
  if (elFail) elFail.textContent = failCount;
}

// 8. Render Strategy Summary Cards (5 Strategic Pillars with Mini Donut Progress Charts)
function renderStrategySummaryCards() {
  const container = document.getElementById('strategy-summary-grid');
  if (!container) return;

  const strategies = [
    { num: 1, name: 'ส่งเสริมสุขภาพ ป้องกัน ควบคุมโรค ภัยสุขภาพ อนามัยสิ่งแวดล้อม และคุ้มครองผู้บริโภค', shortCode: 'P&P', icon: '🛡️', color: '#0ea5e9' },
    { num: 2, name: 'บริการเป็นเลิศ (Service Excellence)', shortCode: 'Service', icon: '🏥', color: '#10b981' },
    { num: 3, name: 'บุคลากรเป็นเลิศ (People Excellence)', shortCode: 'People', icon: '👥', color: '#8b5cf6' },
    { num: 4, name: 'บริหารเป็นเลิศด้วยธรรมาภิบาล (Governance Excellence)', shortCode: 'Governance', icon: '⚖️', color: '#f59e0b' },
    { num: 5, name: 'ส่งเสริมการท่องเที่ยวเชิงสุขภาพความงาม และแพทย์แผนไทย', shortCode: 'Health Economy', icon: '🌿', color: '#ec4899' }
  ];

  const yearKey = AppState.selectedYear === 'all' ? '68' : AppState.selectedYear;

  container.innerHTML = strategies.map(s => {
    const kpis = AppState.kpiData.filter(k => k.strategy.includes(`ยุทธศาสตร์ที่ ${s.num}`));
    let pass = 0;
    let fail = 0;
    let pending = 0;

    kpis.forEach(k => {
      const res = evaluateStatus(k, yearKey);
      if (res.status === 'pass') {
        pass++;
      } else if (res.status === 'warn' || res.status === 'fail') {
        fail++;
      } else {
        pending++;
      }
    });

    const evaluatedTotal = pass + fail;
    const rate = evaluatedTotal > 0 ? Math.round((pass / evaluatedTotal) * 100) : (kpis.length > 0 && pass > 0 ? Math.round((pass / kpis.length) * 100) : 0);

    return `
      <div class="strategy-health-card" onclick="filterBySpecificStrategy('ยุทธศาสตร์ที่ ${s.num}')" title="คลิกเพื่อดูตัวชี้วัดยุทธศาสตร์ที่ ${s.num}">
        <!-- Top Tag & Icon Header -->
        <div class="strat-card-top">
          <span class="strat-badge" style="background: ${s.color};">
            <span class="strat-icon">${s.icon}</span> ยุทธศาสตร์ ${s.num}
          </span>
          <span class="strat-tag-sub">${s.shortCode}</span>
        </div>

        <!-- Strategy Name -->
        <div class="strat-name" title="${s.name}">${s.name}</div>

        <!-- Mini Donut Centerpiece -->
        <div class="strat-donut-container">
          <div class="mini-donut-wrap">
            <svg class="mini-donut-svg" viewBox="0 0 36 36">
              <path class="donut-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" stroke-width="3.6" fill="none" />
              <path class="donut-segment" stroke="${s.color}" stroke-dasharray="${rate}, 100" stroke-dashoffset="0" stroke-linecap="round" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" stroke-width="3.6" fill="none" />
            </svg>
            <div class="donut-center-content">
              <span class="donut-center-rate" style="color: ${s.color};">${rate}%</span>
              <span class="donut-center-sub">สำเร็จ</span>
            </div>
          </div>
        </div>

        <!-- Metrics Breakdown Grid -->
        <div class="strat-breakdown-grid">
          <div class="breakdown-item pass">
            <span class="breakdown-label">🟢 ผ่าน</span>
            <strong class="breakdown-val">${pass}</strong>
          </div>
          <div class="breakdown-item fail">
            <span class="breakdown-label">🔴 ไม่ผ่าน</span>
            <strong class="breakdown-val">${fail}</strong>
          </div>
          <div class="breakdown-item total">
            <span class="breakdown-label">⚪ รวม</span>
            <strong class="breakdown-val">${kpis.length}</strong>
          </div>
        </div>

        <!-- Footer View Link -->
        <div class="strat-card-footer">
          <span class="strat-view-link">ดูตัวชี้วัด &rarr;</span>
        </div>
      </div>
    `;
  }).join('');
}

// 9. Render Sentinel Health Watch List
function renderSentinelWatchList() {
  const container = document.getElementById('sentinel-watch-container');
  if (!container) return;

  const sentinelIds = ['KPI-08', 'KPI-09', 'KPI-12', 'KPI-21', 'KPI-22', 'KPI-27', 'KPI-28'];
  const sentinelKpis = AppState.kpiData.filter(k => sentinelIds.includes(k.id));
  const yearKey = AppState.selectedYear === 'all' ? '68' : AppState.selectedYear;

  container.innerHTML = sentinelKpis.map(kpi => {
    const actualFormatted = formatActualWithColor(kpi, yearKey);
    const target = kpi[`target${yearKey}`] || '-';

    return `
      <div class="sentinel-item" onclick="openKPIDetailModal('${kpi.id}')">
        <div class="sentinel-info">
          <span class="sentinel-id">${kpi.id}</span>
          <span class="sentinel-title">${kpi.name}</span>
        </div>
        <div class="sentinel-val-wrap">
          <div class="sentinel-val">${actualFormatted} <span style="font-size: 0.7rem; font-weight: 400; color: var(--text-muted);">${kpi.unit}</span></div>
          <div class="sentinel-target">เป้า: ${target}</div>
        </div>
      </div>
    `;
  }).join('');
}

// 10. Render KPI List (Cards & Table)
function renderKPIList() {
  const container = document.getElementById('kpi-display-container');
  const countEl = document.getElementById('kpi-filtered-count');
  if (!container) return;

  const yearKey = AppState.selectedYear === 'all' ? '68' : AppState.selectedYear;

  let filtered = AppState.kpiData.filter(kpi => {
    if (AppState.activeStrategyFilter !== 'all' && !kpi.strategy.includes(AppState.activeStrategyFilter)) return false;
    if (AppState.activeStatusFilter !== 'all') {
      const evalRes = evaluateStatus(kpi, yearKey);
      if (evalRes.status !== AppState.activeStatusFilter) return false;
    }
    if (AppState.searchQuery) {
      const q = AppState.searchQuery;
      const combined = `${kpi.id} ${kpi.name} ${kpi.strategy} ${kpi.objective} ${kpi.notes} ${kpi.lineage}`.toLowerCase();
      if (!combined.includes(q)) return false;
    }
    return true;
  });

  if (countEl) countEl.textContent = `${filtered.length} รายการ`;

  if (filtered.length === 0) {
    container.innerHTML = `
      <div style="grid-column: 1 / -1; padding: 3rem; text-align: center; color: var(--text-muted);">
        <p style="font-size: 1.1rem; font-weight: 600;">ไม่พบตัวชี้วัดที่ตรงกับเงื่อนไขการค้นหา</p>
        <p style="font-size: 0.85rem; margin-top: 0.5rem;">ลองปรับเปลี่ยนตัวกรองยุทธศาสตร์ สถานะ หรือคำค้นหาใหม่</p>
      </div>
    `;
    return;
  }

  if (AppState.viewMode === 'grid') {
    container.className = 'kpi-cards-grid';
    container.innerHTML = filtered.map(kpi => {
      const evalRes = evaluateStatus(kpi, yearKey);
      const target = kpi[`target${yearKey}`] || '-';

      return `
        <div class="kpi-card" onclick="openKPIDetailModal('${kpi.id}')">
          <div>
            <div class="kpi-card-top">
              <span class="kpi-id-pill">${kpi.id}</span>
              <span class="badge-status ${evalRes.badgeClass}">${evalRes.label}</span>
            </div>
            <div class="kpi-card-title">${kpi.name}</div>
          </div>

          <div class="kpi-target-actual-grid">
            <div class="ta-col">
              <span class="ta-label">ผล 66</span>
              <span class="ta-val">${kpi.actual66 !== null ? kpi.actual66 : '-'}</span>
            </div>
            <div class="ta-col">
              <span class="ta-label">ผล 67</span>
              <span class="ta-val">${formatActualWithColor(kpi, '67')}</span>
            </div>
            <div class="ta-col">
              <span class="ta-label">ผล 68</span>
              <span class="ta-val">${formatActualWithColor(kpi, '68')}</span>
            </div>
            <div class="ta-col">
              <span class="ta-label">เป้า 69</span>
              <span class="ta-val" style="color: #0f172a;">${kpi.target69 || '-'}</span>
            </div>
            <div class="ta-col">
              <span class="ta-label">เป้า 70</span>
              <span class="ta-val" style="color: #0f172a;">${kpi.target70 || '-'}</span>
            </div>
          </div>

          <div class="kpi-card-bottom">
            <span>${kpi.strategy}</span>
            <span class="kpi-lineage-tag">${kpi.lineage ? '✨ ' + kpi.lineage : 'คลิกดู Insight & AI →'}</span>
          </div>
        </div>
      `;
    }).join('');
  } else {
    container.className = 'table-responsive-container';
    container.innerHTML = `
      <table class="kpi-table">
        <thead>
          <tr>
            <th rowspan="2" class="col-kpi-id">รหัส</th>
            <th rowspan="2" class="col-kpi-name">ชื่อตัวชี้วัดเชิงยุทธศาสตร์</th>
            <th rowspan="2" class="col-num">หน่วยวัด</th>
            
            <th colspan="2" class="col-year-group">ปี 2566</th>
            <th colspan="2" class="col-year-group">ปี 2567</th>
            <th colspan="2" class="col-year-group">ปี 2568</th>
            <th colspan="2" class="col-year-group">ปี 2569</th>
            <th colspan="2" class="col-year-group">ปี 2570</th>
            
            <th rowspan="2" class="col-status">สถานะ (${yearKey})</th>
          </tr>
          <tr class="sub-header-row">
            <th class="col-num col-sub-header">เป้าหมาย</th>
            <th class="col-num col-sub-header">ผลงาน</th>
            
            <th class="col-num col-sub-header">เป้าหมาย</th>
            <th class="col-num col-sub-header">ผลงาน</th>
            
            <th class="col-num col-sub-header">เป้าหมาย</th>
            <th class="col-num col-sub-header">ผลงาน</th>
            
            <th class="col-num col-sub-header">เป้าหมาย</th>
            <th class="col-num col-sub-header">ผลงาน</th>
            
            <th class="col-num col-sub-header">เป้าหมาย</th>
            <th class="col-num col-sub-header">ผลงาน</th>
          </tr>
        </thead>
        <tbody>
          ${filtered.map(kpi => {
            const evalRes = evaluateStatus(kpi, yearKey);
            return `
              <tr onclick="openKPIDetailModal('${kpi.id}')">
                <td class="col-kpi-id"><span class="kpi-id-pill">${kpi.id}</span></td>
                <td class="col-kpi-name"><strong>${kpi.name}</strong></td>
                <td class="col-num">${kpi.unit}</td>
                
                <!-- ปี 2566 -->
                <td class="col-num col-target">${kpi.target66 || '-'}</td>
                <td class="col-num">${kpi.actual66 !== null && kpi.actual66 !== undefined && kpi.actual66 !== '' ? formatActualWithColor(kpi, '66') : '-'}</td>
                
                <!-- ปี 2567 -->
                <td class="col-num col-target">${kpi.target67 || '-'}</td>
                <td class="col-num">${formatActualWithColor(kpi, '67')}</td>
                
                <!-- ปี 2568 -->
                <td class="col-num col-target">${kpi.target68 || '-'}</td>
                <td class="col-num">${formatActualWithColor(kpi, '68')}</td>
                
                <!-- ปี 2569 -->
                <td class="col-num col-target">${kpi.target69 || '-'}</td>
                <td class="col-num">${kpi.actual69 !== undefined && kpi.actual69 !== null && kpi.actual69 !== '' ? formatActualWithColor(kpi, '69') : '-'}</td>
                
                <!-- ปี 2570 -->
                <td class="col-num col-target">${kpi.target70 || '-'}</td>
                <td class="col-num">${kpi.actual70 !== undefined && kpi.actual70 !== null && kpi.actual70 !== '' ? formatActualWithColor(kpi, '70') : '-'}</td>
                
                <td class="col-status"><span class="badge-status ${evalRes.badgeClass}">${evalRes.label}</span></td>
              </tr>
            `;
          }).join('')}
        </tbody>
      </table>
    `;
  }
}

// 11. Domain Specific Health Interventions
function getDomainStrategicIntervention(kpi) {
  const name = kpi.name.toLowerCase();
  const id = kpi.id;

  if (id === 'KPI-08' || name.includes('มารดา')) {
    return {
      strategy: 'ยกระดับ Fast-Track ฝากครรภ์คุณภาพ (ANC คุณภาพ 100%) และขยายระบบสูติ-นรีแพทย์ Tele-Consultation 24 ชม. ข้ามเครือข่าย',
      project: 'โครงการ Safe Motherhood & High-Risk Pregnancy Fast-Track สสจ.ขอนแก่น'
    };
  }
  if (id === 'KPI-09' || name.includes('ทารก')) {
    return {
      strategy: 'เพิ่มขีดความสามารถการช่วยฟื้นคืนชีพทารกแรกเกิด (NRP) ใน รพช. 26 อำเภอ และระบบเคลื่อนย้ายทารกวิกฤต',
      project: 'โครงการพัฒนามาตรฐานห้องคลอดและหออภิบาลทารกแรกเกิดวิกฤต (NICU Network)'
    };
  }
  if (id === 'KPI-12' || id === 'KPI-13' || name.includes('ลำไส้ใหญ่') || name.includes('fit test')) {
    return {
      strategy: 'ขับเคลื่อนคัดกรอง FIT Test เชิงรุกในกลุ่ม 50–70 ปี 100% ร่วมกับ พชอ. Plus และจัดระบบ Fast-Track ส่องกล้อง Colonoscopy ภายใน 4 สัปดาห์',
      project: 'โครงการ Khon Kaen Colorectal Cancer Screening & Fast-Track Colonoscopy'
    };
  }
  if (id === 'KPI-21' || name.includes('sepsis') || name.includes('ติดเชื้อในกระแสเลือด')) {
    return {
      strategy: 'นำร่อง Sepsis Early Warning Score (MEWS) ใน รพช. ทุกแห่ง และให้ยาปฏิชีวนะทางหลอดเลือดดำภายใน 1 ชม. (Sepsis Bundle)',
      project: 'โครงการพัฒนาเครือข่ายการดูแลผู้ป่วย Sepsis แบบไร้รอยต่อ จ.ขอนแก่น'
    };
  }
  if (id === 'KPI-22' || name.includes('stroke') || name.includes('หลอดเลือดสมอง')) {
    return {
      strategy: 'บูรณาการ 1669 กับ Stroke Unit รพศ.ขอนแก่น ให้ยาสลายลิ่มเลือด rtPA ภายใน 4.5 ชม. และระบบส่งต่อ Thrombectomy',
      project: 'โครงการ Stroke Fast-Track 26 อำเภอ สสจ.ขอนแก่น'
    };
  }
  if (id === 'KPI-27' || id === 'KPI-28' || name.includes('เบาหวาน') || name.includes('ความดัน')) {
    return {
      strategy: 'ยกระดับคลินิก NCD คุณภาพ เชื่อมกลไก พชอ. Plus และ HLC เพื่อปรับเปลี่ยนพฤติกรรมลดหวานมันเค็มแบบเข้มข้น',
      project: 'โครงการขอนแก่นรวมพลังลดหวานมันเค็ม คุมเข้มเบาหวาน-ความดันโลหิตสูง'
    };
  }
  return {
    strategy: `เสริมสร้างกลไกกำกับติดตามรายไตรมาสร่วมกับ 26 อำเภอ พัฒนาระบบข้อมูล Real-time และขยายเครือข่ายบริการสุขภาพปฐมภูมิ`,
    project: `โครงการขับเคลื่อนยุทธศาสตร์สุขภาพและพัฒนาศักยภาพเครือข่ายบริการสุขภาพ สสจ.ขอนแก่น`
  };
}

// 12. Modal & Trend Chart Rendering
function getKPIPointColor(kpi, yearKey) {
  const val = extractNumber(kpi[`actual${yearKey}`]);
  const target = extractNumber(kpi[`target${yearKey}`]);
  if (val === null || target === null) return '#0284c7';
  const dir = kpi.direction || 'ยิ่งมากยิ่งดี';
  const passed = dir.includes('ยิ่งน้อยยิ่งดี') ? (val <= target) : (val >= target);
  return passed ? '#10b981' : '#ef4444';
}

function openKPIDetailModal(kpiId) {
  const kpi = AppState.kpiData.find(k => k.id === kpiId);
  if (!kpi) return;

  const modal = document.getElementById('kpi-detail-modal');
  const dialog = document.getElementById('kpi-insight-dialog');
  if (!modal || !dialog) return;

  const kpis = AppState.kpiData;
  const currentIndex = kpis.findIndex(k => k.id === kpiId);
  const counterText = `${currentIndex + 1} / ${kpis.length}`;

  modal.setAttribute('data-kpi-id', kpi.id);

  const stat = AIPredictionEngine.calculateStatisticalForecast(kpi, 1);
  const currentModel = GeminiModelManager.getCurrentModel();

  dialog.innerHTML = `
    <!-- Header -->
    <div class="modal-insight-header">
      <div>
        <div class="modal-header-meta">
