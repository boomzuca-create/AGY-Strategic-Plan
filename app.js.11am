const AI_MODEL_CONFIG = {
  mode: 'AUTO', // 'AUTO' or 'PRIMARY_ONLY'
  primary_model_id: 'gemini-2.5-flash',
  secondary_model_id: 'gemini-2.5-flash-lite',
  fallback_model_id: 'gemini-2.0-flash',
  auto_discovery_enabled: true,
  check_interval_hours: 24,
  last_model_check: new Date().toISOString(),
  free_tier_enforced: true,
  system_version: '2.0.0-PROD'
};

class GeminiModelManagerService {
  constructor() {
    this.registry = this.loadRegistry();
    this.config = this.loadConfig();
    this.activeModel = this.selectBestModel('primary');
  }

  loadRegistry() {
    const saved = localStorage.getItem('gemini_model_registry');
    if (saved) {
      try { return JSON.parse(saved); } catch(e) {}
    }
    return GEMINI_MODEL_REGISTRY;
  }

  saveRegistry() {
    localStorage.setItem('gemini_model_registry', JSON.stringify(this.registry));
  }

  loadConfig() {
    const saved = localStorage.getItem('ai_model_config');
    if (saved) {
      try { return JSON.parse(saved); } catch(e) {}
    }
    return AI_MODEL_CONFIG;
  }

  saveConfig() {
    localStorage.setItem('ai_model_config', JSON.stringify(this.config));
  }

  selectBestModel(tier = 'primary') {
    const eligible = this.registry.filter(m => m.status === 'ACTIVE' && m.free_tier && m.lifecycle === 'GA');
    eligible.sort((a, b) => (b.score || 0) - (a.score || 0));

    if (tier === 'primary') return eligible[0] || this.registry[0];
    if (tier === 'secondary') return eligible[1] || eligible[0] || this.registry[0];
    return eligible[eligible.length - 1] || this.registry[0];
  }

  getCurrentModel() {
    return this.selectBestModel('primary');
  }

  async checkCatalogUpdates() {
    this.config.last_model_check = new Date().toISOString();
    this.saveConfig();
    return {
      status: 'UP_TO_DATE',
      currentModel: this.getCurrentModel(),
      checkedAt: new Date(this.config.last_model_check).toLocaleString('th-TH')
    };
  }
}

const GeminiModelManager = new GeminiModelManagerService();

// =========================================================================
// 2. AUDIT LOGGER
// =========================================================================

class AIAuditLoggerService {
  getLogs() {
    try {
      return JSON.parse(localStorage.getItem('ai_prediction_audit_log') || '[]');
    } catch(e) {
      return [];
    }
  }

  logPrediction(record) {
    const logs = this.getLogs();
    const newRecord = {
      id: 'AUDIT-' + Date.now().toString(36).toUpperCase(),
      timestamp: new Date().toISOString(),
      system_version: AI_MODEL_CONFIG.system_version,
      ...record
    };
    logs.unshift(newRecord);
    if (logs.length > 50) logs.pop();
    localStorage.setItem('ai_prediction_audit_log', JSON.stringify(logs));
    return newRecord;
  }

  clear() {
    localStorage.removeItem('ai_prediction_audit_log');
  }
}

const AIAuditLogger = new AIAuditLoggerService();

// =========================================================================
// 3. STATISTICAL PREDICTION ENGINE (Mathematical Layer)
// =========================================================================

class AIPredictionEngineService {
  validateDataQuality(kpi) {
    const actuals = [kpi.actual66, kpi.actual67, kpi.actual68];
    const validCount = actuals.filter(v => v !== null && v !== undefined && v !== '' && v !== '-').length;

    if (validCount === 0) {
      return { status: 'INSUFFICIENT_DATA', label: '🔵 ข้อมูลไม่เพียงพอ', score: 0, reason: 'ไม่มีข้อมูลผลงานจริงย้อนหลัง' };
    }
    if (validCount === 1) {
      return { status: 'WARNING', label: '🟡 ข้อมูลจำกัด (1 ปี)', score: 50, reason: 'มีผลงานจริงเพียง 1 ปี ความแม่นยำอาจจำกัด' };
    }
    if (validCount === 2) {
      return { status: 'GOOD', label: '🟢 ข้อมูลดี (2 ปีต่อเนื่อง)', score: 80, reason: 'มีข้อมูล 2 ปีย้อนหลังเพียงพอต่อการสร้างแนวโน้ม' };
    }
    return { status: 'EXCELLENT', label: '🟢 ข้อมูลสมบูรณ์ (3 ปีต่อเนื่อง)', score: 100, reason: 'ข้อมูลครบถ้วน 2566–2568 พร้อมพยากรณ์' };
  }

  calculateStatisticalForecast(kpi, horizon = 1) {
    const a66 = extractNumber(kpi.actual66);
    const a67 = extractNumber(kpi.actual67);
    const a68 = extractNumber(kpi.actual68);
    const t68 = extractNumber(kpi.target68);
    const t69 = extractNumber(kpi.target69);
    const t70 = extractNumber(kpi.target70);
    const target = horizon === 2 ? (t70 || t69) : (t69 || t68);
    const direction = kpi.direction || 'ยิ่งมากยิ่งดี';
    const isLowerBetter = direction.includes('ยิ่งน้อยยิ่งดี');

    const validPoints = [];
    if (a66 !== null) validPoints.push({ x: 1, y: a66 });
    if (a67 !== null) validPoints.push({ x: 2, y: a67 });
    if (a68 !== null) validPoints.push({ x: 3, y: a68 });

    const dataQuality = this.validateDataQuality(kpi);

    if (validPoints.length === 0) {
      return {
        dataQuality,
        predictionStatus: 'INSUFFICIENT_DATA',
        baseline: null,
        optimistic: null,
        pessimistic: null,
        growthRateYoY: null,
        momentum: 0,
        variance: 0,
        probabilityOfAchievement: 0,
        confidenceScore: 0,
        riskLevel: 'UNKNOWN'
      };
    }

    // 1. Current Value & Growth Rate
    const currentValue = a68 !== null ? a68 : (a67 !== null ? a67 : a66);
    let growthRateYoY = 0;
    if (a68 !== null && a67 !== null && a67 !== 0) {
      growthRateYoY = parseFloat((((a68 - a67) / Math.abs(a67)) * 100).toFixed(2));
    }

    // 2. Linear Trend & Momentum
    let slope = 0;
    let baseline = currentValue;
    if (validPoints.length >= 2) {
      const pLast = validPoints[validPoints.length - 1];
      const pPrev = validPoints[validPoints.length - 2];
      slope = pLast.y - pPrev.y;
      baseline = parseFloat((currentValue + (slope * horizon)).toFixed(2));
    } else {
      baseline = currentValue;
    }

    // 3. Variance & Standard Deviation
    const values = validPoints.map(p => p.y);
    const avg = values.reduce((sum, v) => sum + v, 0) / values.length;
    const variance = values.reduce((sum, v) => sum + Math.pow(v - avg, 2), 0) / values.length;
    const stdDev = Math.sqrt(variance);

    // 4. Scenario Forecasts
    const buffer = Math.max(Math.abs(baseline) * 0.08, stdDev * 0.5, 0.5);
    let optimistic = 0;
    let pessimistic = 0;

    if (isLowerBetter) {
      optimistic = parseFloat(Math.max(0, baseline - buffer).toFixed(2));
      pessimistic = parseFloat((baseline + buffer).toFixed(2));
    } else {
      optimistic = parseFloat((baseline + buffer).toFixed(2));
      pessimistic = parseFloat(Math.max(0, baseline - buffer).toFixed(2));
    }

    // 5. Target Achievement Probability (%)
    let probabilityOfAchievement = 50;
    if (target !== null) {
      const gap = isLowerBetter ? (target - baseline) : (baseline - target);
      if (gap >= 0) {
        // Forecast meets or exceeds target
        probabilityOfAchievement = Math.min(95, Math.round(75 + (gap / (target || 1)) * 30));
      } else {
        // Forecast falls behind target
        const deficitRatio = Math.abs(gap) / (target || 1);
        probabilityOfAchievement = Math.max(8, Math.round(60 - (deficitRatio * 80)));
      }
    }

    // 6. Confidence Score (%)
    let confidenceScore = 60;
    if (validPoints.length === 3) confidenceScore += 20;
    else if (validPoints.length === 2) confidenceScore += 10;
    if (stdDev < Math.abs(avg) * 0.15) confidenceScore += 10;
    if (kpi.lineage && kpi.lineage.includes('ปรับ')) confidenceScore -= 10;
    confidenceScore = Math.max(40, Math.min(94, confidenceScore));

    // 7. Risk Level & Status
    let riskLevel = 'LOW';
    let predictionStatus = 'ON_TRACK';
    if (probabilityOfAchievement < 30) {
      riskLevel = 'CRITICAL';
      predictionStatus = 'OFF_TRACK';
    } else if (probabilityOfAchievement < 55) {
      riskLevel = 'HIGH';
      predictionStatus = 'AT_RISK';
    } else if (probabilityOfAchievement < 75) {
      riskLevel = 'MODERATE';
      predictionStatus = 'WATCH';
    }

    return {
      kpiId: kpi.id,
      currentValue,
      targetValue: target,
      horizonYears: horizon,
      growthRateYoY,
      momentum: parseFloat(slope.toFixed(2)),
      variance: parseFloat(variance.toFixed(2)),
      baseline,
      optimistic,
      pessimistic,
      probabilityOfAchievement,
      confidenceScore,
      riskLevel,
      predictionStatus,
      dataQuality
    };
  }
}

