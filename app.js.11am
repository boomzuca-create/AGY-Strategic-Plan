              <span class="ai-metric-label">Baseline Forecast 69:</span>
              <span class="ai-metric-val font-mono" style="color: var(--teal-light);">${stat.baseline !== null ? stat.baseline + ' ' + kpi.unit : '-'}</span>
            </div>
            <div class="ai-metric-card">
              <span class="ai-metric-label">ความน่าจะเป็นบรรลุเป้า:</span>
              <span class="ai-metric-val ${stat.probabilityOfAchievement >= 70 ? 'text-kpi-pass' : 'text-kpi-fail'}">${stat.probabilityOfAchievement}%</span>
            </div>
            <div class="ai-metric-card">
              <span class="ai-metric-label">ระดับความเสี่ยง (Risk):</span>
              <span class="ai-metric-val">
                <span class="badge-status ${stat.riskLevel === 'LOW' ? 'pass' : stat.riskLevel === 'MODERATE' ? 'warn' : 'fail'}">
                  ${stat.riskLevel}
                </span>
              </span>
            </div>
            <div class="ai-metric-card">
              <span class="ai-metric-label">Confidence Score:</span>
              <span class="ai-metric-val font-mono">${stat.confidenceScore}%</span>
            </div>
          </div>

          <div class="ai-output-container" id="ai-output-container">
            <div class="ai-default-strategy">
              <div class="ai-strategy-item">
                <span class="ai-strategy-badge">🎯 มาตรการเชิงรุกแนะนำ:</span>
                <span class="ai-strategy-text">${getDomainStrategicIntervention(kpi).strategy}</span>
              </div>
              <div class="ai-strategy-item" style="margin-top: 0.35rem;">
                <span class="ai-strategy-badge">📋 โครงการเร่งรัด:</span>
                <span class="ai-strategy-text">${getDomainStrategicIntervention(kpi).project}</span>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Footer -->
    <div class="modal-insight-footer">
      <div style="margin-right: auto; display: flex; gap: 0.5rem; align-items: center;">
        <span class="meta-pill">
          <span class="meta-pill-label">ทิศทาง:</span> <strong>${kpi.direction}</strong>
        </span>
        <span class="meta-pill">
          <span class="meta-pill-label">เป้าหมายปี 69:</span> <strong>${kpi.target69 || '-'} ${kpi.unit}</strong>
        </span>
        <span class="meta-pill" style="color: var(--teal-light); font-weight: 700;">
          ${counterText}
        </span>
      </div>
      <div class="modal-nav-actions">
        <button class="btn-modal-nav" id="btn-modal-prev" onclick="navigateKPIModal('prev', '${kpi.id}')" title="ดู KPI ก่อนหน้า (←)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          <span>Prev</span>
        </button>
        <button class="btn-modal-nav" id="btn-modal-next" onclick="navigateKPIModal('next', '${kpi.id}')" title="ดู KPI ถัดไป (→)">
          <span>Next</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
        <button class="btn btn-secondary btn-sm" onclick="printOnePageLandscapeReport()" title="พิมพ์รายงาน 16:9 แนวนอน 1 แผ่น">📑 พิมพ์รายงาน</button>
        <button class="btn-close-modal" onclick="closeModal()">ปิดหน้าต่าง</button>
      </div>
    </div>
  `;

  modal.classList.add('show');
  setTimeout(() => renderModalKPIChart(kpi), 60);
}

function navigateKPIModal(direction, currentId) {
  const kpis = AppState.kpiData;
  const currentIndex = kpis.findIndex(k => k.id === currentId);
  if (currentIndex === -1) return;

  let targetIndex = currentIndex;
  if (direction === 'prev') {
    targetIndex = (currentIndex - 1 + kpis.length) % kpis.length;
  } else if (direction === 'next') {
    targetIndex = (currentIndex + 1) % kpis.length;
  }

  const targetKpi = kpis[targetIndex];
  if (targetKpi) {
    openKPIDetailModal(targetKpi.id);
  }
}

function renderModalKPIChart(kpi) {
  const canvas = document.getElementById('chart-modal-kpi');
  if (!canvas) return;

  if (AppState.charts.modalKPI) {
    AppState.charts.modalKPI.destroy();
    AppState.charts.modalKPI = null;
  }

  const ctx = canvas.getContext('2d');
  const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
  const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
  const textColor = isDark ? '#94a3b8' : '#64748b';
  const pointBorder = isDark ? '#0f172a' : '#ffffff';

  const labels = ['2566', '2567', '2568', '2569 (เป้า)', '2570 (เป้า)'];
  const t66 = extractNumber(kpi.target66);
  const t67 = extractNumber(kpi.target67);
  const t68 = extractNumber(kpi.target68);
  const t69 = extractNumber(kpi.target69);
  const t70 = extractNumber(kpi.target70);

  const a66 = extractNumber(kpi.actual66);
  const a67 = extractNumber(kpi.actual67);
  const a68 = extractNumber(kpi.actual68);
  const a69 = extractNumber(kpi.actual69);

  const pointColors = [
    getKPIPointColor(kpi, '66') || '#0284c7',
    getKPIPointColor(kpi, '67') || '#0284c7',
    getKPIPointColor(kpi, '68') || '#0284c7',
    getKPIPointColor(kpi, '69') || '#0284c7',
    '#0284c7'
  ];

  const gradActual = ctx.createLinearGradient(0, 0, 0, 240);
  gradActual.addColorStop(0, 'rgba(2, 132, 199, 0.22)');
  gradActual.addColorStop(1, 'rgba(2, 132, 199, 0.01)');

  AppState.charts.modalKPI = new Chart(canvas, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [
        {
          label: 'ผลงานจริง (Actual)',
          data: [a66, a67, a68, (a69 !== null ? a69 : null), null],
          borderColor: '#0284c7',
          borderWidth: 3.5,
          backgroundColor: gradActual,
          pointBackgroundColor: pointColors,
          pointBorderColor: pointBorder,
          pointBorderWidth: 2.5,
          pointRadius: 7,
          pointHoverRadius: 10,
          fill: true,
          tension: 0.25
        },
        {
          label: 'เป้าหมาย (Target)',
          data: [t66, t67, t68, t69, t70],
          borderColor: '#94a3b8',
          borderDash: [5, 5],
          borderWidth: 2.5,
          pointBackgroundColor: '#94a3b8',
          pointBorderColor: pointBorder,
          pointBorderWidth: 2,
          pointRadius: 5.5,
          fill: false,
          tension: 0.15
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: { grid: { color: gridColor }, ticks: { color: textColor }, title: { display: true, text: kpi.unit || '', color: textColor } },
        x: { grid: { display: false }, ticks: { color: textColor } }
      },
      plugins: {
        legend: { display: false }
      }
    }
  });
}

function closeModal() {
  document.querySelectorAll('.modal-backdrop').forEach(m => m.classList.remove('show'));
}

// 13. Modal AI Prediction Runner
function runModalAIPrediction(kpiId) {
  const kpi = AppState.kpiData.find(k => k.id === kpiId);
  if (!kpi) return;

  const stat = AIPredictionEngine.calculateStatisticalForecast(kpi, 1);
  const domain = getDomainStrategicIntervention(kpi);
  const outContainer = document.getElementById('ai-output-container');
  if (!outContainer) return;

  outContainer.innerHTML = `
    <div style="font-size:0.75rem; line-height:1.45;">
      <h4 style="color:var(--cyan-light); margin-bottom:0.3rem;">🔮 ผลการพยากรณ์และวิเคราะห์สถานการณ์</h4>
      <p>• <strong>Baseline Forecast 2569:</strong> ${stat.baseline} ${kpi.unit} (ความน่าจะเป็นบรรลุเป้า: <strong>${stat.probabilityOfAchievement}%</strong>)</p>
      <p>• <strong>3 Scenarios:</strong> Optimistic = <strong>${stat.optimistic}</strong> | Baseline = <strong>${stat.baseline}</strong> | Pessimistic = <strong>${stat.pessimistic}</strong></p>
      <h4 style="color:var(--teal-light); margin:0.4rem 0 0.2rem 0;">🎯 มาตรการเชิงรุก (Strategic Interventions)</h4>
      <p>• ${domain.strategy}</p>
      <h4 style="color:var(--status-warn); margin:0.4rem 0 0.2rem 0;">⚡ ข้อเสนอตัดสินใจเชิงบริหาร</h4>
      <p>• ${stat.probabilityOfAchievement >= 70 ? 'กำกับติดตามผลงานรายไตรมาสต่อเนื่องตามแผน' : 'ต้องเร่งรัดขับเคลื่อนมาตรการ Fast-Track ในพื้นที่ 26 อำเภอทันที'}</p>
    </div>
  `;
}

// 14. AI Strategy & Prediction Center View Logic
function updateAIStatusUI() {
  const currentModel = GeminiModelManager.getCurrentModel();
  const nameEl = document.getElementById('status-model-name');
  const checkEl = document.getElementById('status-last-check');
  const subtagEl = document.getElementById('ai-model-subtag-text');

  if (nameEl) nameEl.textContent = `${currentModel.model_name} (Auto Selected)`;
  if (checkEl) checkEl.textContent = new Date(GeminiModelManager.config.last_model_check).toLocaleTimeString('th-TH');
  if (subtagEl) subtagEl.textContent = `Model: ${currentModel.model_name} • Mode: Auto • Free Tier Active`;
}

function populateAICenter() {
  const selectEl = document.getElementById('ai-center-kpi-select');
  if (!selectEl) return;

  if (selectEl.options.length === 0) {
    selectEl.innerHTML = AppState.kpiData.map(k => `
      <option value="${k.id}">[${k.id}] ${k.name} (${k.strategy})</option>
    `).join('');
  }

  if (AppState.kpiData.length > 0) {
    onAICenterKPISelected(selectEl.value || AppState.kpiData[0].id);
  }
  updateAIStatusUI();
}

function onAICenterKPISelected(kpiId) {
  const kpi = AppState.kpiData.find(k => k.id === kpiId);
  if (!kpi) return;

  const stat = AIPredictionEngine.calculateStatisticalForecast(kpi, 1);
  const badge = document.getElementById('ai-center-data-quality-badge');
  const quickStats = document.getElementById('ai-kpi-quick-stats');

  if (badge) {
    badge.textContent = stat.dataQuality.label;
    badge.style.color = stat.dataQuality.status === 'EXCELLENT' ? 'var(--status-pass)' : stat.dataQuality.status === 'GOOD' ? 'var(--cyan-light)' : 'var(--status-warn)';
  }

  if (quickStats) {
    quickStats.innerHTML = `
      <div style="font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.35rem; font-weight: 700;">สถิติพื้นฐาน (Historical Metrics):</div>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; text-align: center;">
        <div style="background: var(--bg-surface-elevated); padding: 0.4rem; border-radius: var(--radius-sm);">
          <div style="font-size: 0.65rem; color: var(--text-muted);">ผลงาน 68</div>
          <div style="font-weight: 700; font-size: 0.82rem;">${kpi.actual68 || '-'}</div>
        </div>
        <div style="background: var(--bg-surface-elevated); padding: 0.4rem; border-radius: var(--radius-sm);">
          <div style="font-size: 0.65rem; color: var(--text-muted);">เป้าหมาย 69</div>
          <div style="font-weight: 700; font-size: 0.82rem; color: var(--text-primary);">${kpi.target69 || '-'}</div>
        </div>
        <div style="background: var(--bg-surface-elevated); padding: 0.4rem; border-radius: var(--radius-sm);">
          <div style="font-size: 0.65rem; color: var(--text-muted);">YoY Momentum</div>
          <div style="font-weight: 700; font-size: 0.82rem; color: ${stat.momentum >= 0 ? 'var(--status-pass)' : 'var(--status-fail)'};">${stat.momentum > 0 ? '+' : ''}${stat.momentum}</div>
        </div>
      </div>
    `;
  }
}

async function triggerAICenterAnalysis() {
  const selectEl = document.getElementById('ai-center-kpi-select');
  const horizonEl = document.getElementById('ai-center-horizon-select');
  const customPromptEl = document.getElementById('ai-center-custom-prompt');
  const outBox = document.getElementById('ai-center-output-box');
  const btn = document.getElementById('btn-run-ai-center');

  if (!selectEl || !outBox) return;
  const kpiId = selectEl.value;
  const kpi = AppState.kpiData.find(k => k.id === kpiId);
  if (!kpi) return;

  const horizon = parseInt(horizonEl ? horizonEl.value : '1', 10);
  const currentModel = GeminiModelManager.getCurrentModel();

  if (btn) {
    btn.disabled = true;
    btn.innerHTML = `<span class="ai-spinner" style="width:12px;height:12px;border-width:2px;display:inline-block;vertical-align:middle;"></span> กำลังพยากรณ์และประมวลผล...`;
  }

  outBox.innerHTML = `
    <div class="ai-loading-box">
      <div class="ai-spinner"></div>
      <div style="font-weight:700;color:var(--teal-light);">AI Prediction Engine กำลังวิเคราะห์ข้อมูล 5 ปี และประมวลผล 3 Scenarios...</div>
      <div style="font-size:0.72rem;color:var(--text-muted);">Engine: ${currentModel.model_name} (Auto Selected)</div>
    </div>
  `;

  // Step 1: Execute Mathematical Layer
  const stat = AIPredictionEngine.calculateStatisticalForecast(kpi, horizon);
  const domain = getDomainStrategicIntervention(kpi);

  // Step 2: Log Audit
  AIAuditLogger.logPrediction({
    kpi_id: kpi.id,
    model_id: currentModel.model_id,
    model_name: currentModel.model_name,
    prediction: stat.baseline,
    confidence: stat.confidenceScore,
    risk_level: stat.riskLevel,
    prompt_version: 'v2.0-strategic-json'
  });

  // Step 3: Render in-page preview AND automatically launch Fullscreen Pop-Up Modal
  setTimeout(() => {
    outBox.innerHTML = `
      <div id="ai-center-result-text">
        <!-- Quick Preview Banner -->
        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border-card); padding-bottom:0.75rem; margin-bottom:1rem;">
          <div>
            <div style="font-size:0.72rem; color:var(--teal-light); font-weight:700;">[${kpi.id}] ${kpi.strategy}</div>
            <h3 style="font-size:1.05rem; font-weight:700; color:var(--text-primary); margin-top:0.15rem;">${kpi.name}</h3>
          </div>
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <button class="btn btn-primary btn-sm" onclick="openAIPredictionFullscreenModal('${kpi.id}', ${horizon})" style="font-size:0.76rem; padding:0.35rem 0.75rem;">
              <span>🔍 ดูผลลัพธ์เต็มหน้าจอ</span>
            </button>
            <span class="badge-status ${stat.predictionStatus === 'ON_TRACK' ? 'pass' : stat.predictionStatus === 'WATCH' ? 'warn' : 'fail'}" style="font-size:0.76rem;">
              ${stat.predictionStatus === 'ON_TRACK' ? '🟢 ON TRACK' : stat.predictionStatus === 'WATCH' ? '🟡 WATCH' : '🔴 AT RISK'}
            </span>
          </div>
        </div>

        <!-- 3 Scenario Quick Preview Grid -->
        <div class="scenario-cards-grid">
          <div class="scenario-card baseline">
            <div class="scenario-title">1. Baseline Forecast</div>
            <div class="scenario-val">${stat.baseline !== null ? stat.baseline : '-'} <span style="font-size:0.7rem; font-weight:400;">${kpi.unit}</span></div>
            <div class="scenario-desc">คาดการณ์ตามโมเมนตัมปกติ</div>
          </div>
          <div class="scenario-card optimistic">
            <div class="scenario-title" style="color:var(--status-pass);">2. Optimistic (+Intervention)</div>
            <div class="scenario-val" style="color:var(--status-pass);">${stat.optimistic !== null ? stat.optimistic : '-'} <span style="font-size:0.7rem; font-weight:400;">${kpi.unit}</span></div>
            <div class="scenario-desc">เมื่อเร่งรัดมาตรการเต็มกำลัง</div>
          </div>
          <div class="scenario-card pessimistic">
            <div class="scenario-title" style="color:var(--status-fail);">3. Pessimistic (High Risk)</div>
            <div class="scenario-val" style="color:var(--status-fail);">${stat.pessimistic !== null ? stat.pessimistic : '-'} <span style="font-size:0.7rem; font-weight:400;">${kpi.unit}</span></div>
            <div class="scenario-desc">กรณีเกิดปัจจัยเสี่ยง/ชะลอตัว</div>
          </div>
        </div>

        <div class="ai-metrics-row">
          <div class="ai-metric-pill-card">
            <div style="display:flex; justify-content:space-between; font-size:0.74rem;">
              <span>ความน่าจะเป็นในการบรรลุเป้าหมาย:</span>
              <strong style="color: ${stat.probabilityOfAchievement >= 70 ? 'var(--status-pass)' : 'var(--status-fail)'};">${stat.probabilityOfAchievement}%</strong>
            </div>
            <div class="probability-bar-wrap">
              <div class="probability-bar-fill" style="width: ${stat.probabilityOfAchievement}%; background: ${stat.probabilityOfAchievement >= 70 ? 'var(--status-pass)' : stat.probabilityOfAchievement >= 50 ? 'var(--status-warn)' : 'var(--status-fail)'};"></div>
            </div>
          </div>
          <div class="ai-metric-pill-card">
            <div style="display:flex; justify-content:space-between; font-size:0.74rem;">
              <span>Confidence Score (ความเชื่อมั่น):</span>
              <strong>${stat.confidenceScore}%</strong>
            </div>
            <div style="font-size:0.68rem; color:var(--text-muted); margin-top:0.25rem;">
              ประเมินจากความสมบูรณ์ของข้อมูลย้อนหลัง
            </div>
          </div>
        </div>

        <!-- Section E: Executive Decision -->
        <div class="executive-decision-box">
          <div class="executive-decision-header">
            <span>⚡ Executive Decision Support (ข้อเสนอเพื่อการตัดสินใจของผู้บริหาร)</span>
          </div>
          <div class="executive-decision-text">
            ${stat.probabilityOfAchievement >= 70 
              ? `"ผลการพยากรณ์อยู่ในเกณฑ์ On Track (${stat.probabilityOfAchievement}%) เสนอให้ผู้บริหารเห็นชอบให้ดำเนินการตามแผนงานปกติ และมอบหมายกลุ่มงานที่รับผิดชอบกำกับติดตามรายไตรมาส"` 
              : `"ตัวชี้วัดมีความเสี่ยงที่จะไม่บรรลุเป้าหมาย (Forecast: ${stat.baseline} vs Target: ${stat.targetValue}) เสนอให้ผู้บริหารสั่งการ 'เร่งรัดมาตรการ Fast-Track' และจัดประชุม War Room ร่วมกับ 26 อำเภอภายใน 30 วัน"`
            }
          </div>
        </div>
      </div>
    `;

    if (btn) {
      btn.disabled = false;
      btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg> <span>✨ AI Predict & Analyze</span>`;
    }

    // Auto launch Fullscreen Pop-Up Modal
    openAIPredictionFullscreenModal(kpi.id, horizon, stat, domain);
  }, 350);
}

// 14.1 Fullscreen Executive AI Prediction Modal Function
function openAIPredictionFullscreenModal(kpiId, horizon = 1, statObj = null, domainObj = null) {
  const kpi = AppState.kpiData.find(k => k.id === kpiId);
  if (!kpi) return;

  const stat = statObj || AIPredictionEngine.calculateStatisticalForecast(kpi, horizon);
  const domain = domainObj || getDomainStrategicIntervention(kpi);
  const currentModel = GeminiModelManager.getCurrentModel();

  const modal = document.getElementById('ai-prediction-fullscreen-modal');
  const dialog = document.getElementById('ai-prediction-fullscreen-dialog');
  if (!modal || !dialog) return;

  dialog.innerHTML = `
    <!-- Header -->
    <div class="modal-insight-header">
      <div>
        <div class="modal-header-meta">
          <span class="badge-kpi-id">${kpi.id}</span>
          <span class="breadcrumb-strat">${kpi.strategy} &rsaquo; ${kpi.objective}</span>
          <span class="badge-status ${stat.predictionStatus === 'ON_TRACK' ? 'pass' : stat.predictionStatus === 'WATCH' ? 'warn' : 'fail'}" style="margin-left:0.5rem;">
            ${stat.predictionStatus === 'ON_TRACK' ? '🟢 ON TRACK' : stat.predictionStatus === 'WATCH' ? '🟡 WATCH' : '🔴 AT RISK'}
          </span>
        </div>
        <h2 class="modal-insight-title">${kpi.name}</h2>
      </div>
      <div style="display:flex; align-items:center; gap:0.5rem;">
        <button class="btn btn-secondary btn-sm" onclick="copyAIPredictionModalText('${kpi.id}')" title="คัดลอกผลสรุปทั้งหมด">
          📋 คัดลอก
        </button>
        <button class="modal-close-btn-white" onclick="closeAIPredictionFullscreenModal()">&times;</button>
      </div>
    </div>

    <!-- Body (Widescreen 2-Column Grid) -->
    <div class="modal-insight-body modal-fullscreen-grid">
      
      <!-- Left Column: Trend Trajectory Chart & Scenario Cards -->
      <div class="modal-grid-left">
        <div class="modal-alert-box">
          <div class="modal-alert-icon">i</div>
          <div>
            <div class="modal-alert-title">วิวัฒนาการตัวชี้วัด (Lineage & Data Quality):</div>
            <div class="modal-alert-desc">${kpi.lineage || kpi.notes || 'ตัวชี้วัดต่อเนื่องตามกรอบยุทธศาสตร์สาธารณสุข 2566–2570'} • <strong>${stat.dataQuality.label}</strong></div>
          </div>
        </div>

        <!-- Trend Trajectory Chart with Forecast Envelopes -->
        <div class="modal-chart-card" style="flex: 1; min-height: 240px;">
          <div class="modal-chart-header">
            <span class="modal-chart-title-text">แนวโน้มผลงานจริงและแบบจำลองพยากรณ์ 3 Scenarios (${kpi.unit})</span>
            <span class="badge-blue-soft">${kpi.direction}</span>
          </div>
          <div class="modal-chart-canvas-wrapper">
            <canvas id="chart-ai-prediction-modal"></canvas>
          </div>
          <div class="modal-chart-custom-legend">
            <div class="legend-item"><span class="legend-line-actual"></span> <span>ผลงานจริง (66–68)</span></div>
            <div class="legend-item"><span style="display:inline-block;width:14px;height:3px;background:var(--teal-light);"></span> <span>Forecast (2569)</span></div>
            <div class="legend-item"><span class="legend-line-target"></span> <span>เป้าหมาย (Target)</span></div>
          </div>
        </div>

        <!-- 3 Scenario Prediction Cards -->
        <div class="scenario-cards-grid" style="margin-top: 0.75rem;">
          <div class="scenario-card baseline">
            <div class="scenario-title">1. Baseline Forecast</div>
            <div class="scenario-val">${stat.baseline !== null ? stat.baseline : '-'} <span style="font-size:0.7rem; font-weight:400;">${kpi.unit}</span></div>
            <div class="scenario-desc">คาดการณ์ตามโมเมนตัมปกติ</div>
          </div>
          <div class="scenario-card optimistic">
            <div class="scenario-title" style="color:var(--status-pass);">2. Optimistic (+Intervention)</div>
            <div class="scenario-val" style="color:var(--status-pass);">${stat.optimistic !== null ? stat.optimistic : '-'} <span style="font-size:0.7rem; font-weight:400;">${kpi.unit}</span></div>
            <div class="scenario-desc">เมื่อเร่งรัดมาตรการเต็มกำลัง</div>
          </div>
          <div class="scenario-card pessimistic">
            <div class="scenario-title" style="color:var(--status-fail);">3. Pessimistic (High Risk)</div>
            <div class="scenario-val" style="color:var(--status-fail);">${stat.pessimistic !== null ? stat.pessimistic : '-'} <span style="font-size:0.7rem; font-weight:400;">${kpi.unit}</span></div>
            <div class="scenario-desc">กรณีเกิดปัจจัยเสี่ยง/ชะลอตัว</div>
          </div>
        </div>

        <!-- Probability & Confidence Row -->
        <div class="ai-metrics-row" style="margin-top: 0.5rem; margin-bottom: 0;">
          <div class="ai-metric-pill-card">
            <div style="display:flex; justify-content:space-between; font-size:0.74rem;">
              <span>ความน่าจะเป็นในการบรรลุเป้าหมาย:</span>
              <strong style="color: ${stat.probabilityOfAchievement >= 70 ? 'var(--status-pass)' : 'var(--status-fail)'}; font-size:0.88rem;">${stat.probabilityOfAchievement}%</strong>
            </div>
            <div class="probability-bar-wrap">
              <div class="probability-bar-fill" style="width: ${stat.probabilityOfAchievement}%; background: ${stat.probabilityOfAchievement >= 70 ? 'var(--status-pass)' : stat.probabilityOfAchievement >= 50 ? 'var(--status-warn)' : 'var(--status-fail)'};"></div>
            </div>
          </div>
          <div class="ai-metric-pill-card">
            <div style="display:flex; justify-content:space-between; font-size:0.74rem;">
              <span>Confidence Score (ความเชื่อมั่น):</span>
              <strong style="font-size:0.88rem;">${stat.confidenceScore}%</strong>
            </div>
            <div style="font-size:0.68rem; color:var(--text-muted); margin-top:0.2rem;">
              ระดับความแปรปรวน: ${stat.variance} | YoY Growth: ${stat.growthRateYoY}%
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Scrollable 5-Section Executive AI Brief -->
      <div class="modal-grid-right" style="overflow-y: auto; max-height: 100%; padding-right: 0.35rem;" id="ai-modal-brief-content-${kpi.id}">
        
        <!-- Section A: Current Situation -->
        <div class="ai-section-box">
          <div class="ai-section-title"><span>📌 A. Current Situation (สถานการณ์ปัจจุบัน)</span></div>
          <div class="ai-section-content">
            <p>• <strong>ผลการดำเนินงานจริงล่าสุด (ปี 2568):</strong> <strong>${kpi.actual68 !== null ? kpi.actual68 : '-'} ${kpi.unit}</strong> (ฐานตั้งต้น 2566: ${kpi.actual66 || '-'}, ผลงาน 2567: ${kpi.actual67 || '-'})</p>
            <p>• <strong>เป้าหมายปี 2569:</strong> <strong>${kpi.target69 || '-'} ${kpi.unit}</strong> (เป้าหมายระยะยาวปี 2570: ${kpi.target70 || '-'})</p>
            <p>• <strong>โมเมนตัมและทิศทาง:</strong> อัตราการเปลี่ยนแปลง ${stat.growthRateYoY > 0 ? '+' : ''}${stat.growthRateYoY}% ต่อปี (เกณฑ์ประเมิน: <strong>${kpi.direction}</strong>)</p>
          </div>
        </div>

        <!-- Section C: Risk Detection & Bottlenecks -->
        <div class="ai-section-box">
          <div class="ai-section-title"><span>⚠️ C. Risk Detection & Bottlenecks (ความเสี่ยงและจุดคอขวด)</span></div>
          <div class="ai-section-content">
            <p>• <strong>ระดับความเสี่ยงเชิงยุทธศาสตร์:</strong> <span class="badge-status ${stat.riskLevel === 'LOW' ? 'pass' : stat.riskLevel === 'MODERATE' ? 'warn' : 'fail'}">${stat.riskLevel}</span></p>
            <p>• <strong>จุดคอขวดที่ต้องเฝ้าระวัง:</strong> ${kpi.lineage ? `มีการปรับเปลี่ยนนิยาม/เกณฑ์ตัวชี้วัด (${kpi.lineage}) ส่งผลต่อความต่อเนื่องของฐานข้อมูล ต้องเน้นย้ำมาตรฐานข้อมูลใน 26 อำเภอ` : `ความครอบคลุมในการส่งต่อข้อมูลระหว่างหน่วยบริการปฐมภูมิ (รพ.สต.) และโรงพยาบาลชุมชน (รพช.)`}</p>
          </div>
        </div>

        <!-- Section D: Strategic Interventions -->
        <div class="ai-section-box">
          <div class="ai-section-title"><span>🎯 D. Strategic Interventions (มาตรการเชิงรุกและแผนงานเร่งรัด)</span></div>
          <div class="ai-section-content">
            <ul>
              <li><strong>มาตรการขับเคลื่อนหลัก:</strong> ${domain.strategy}</li>
              <li><strong>กลไกเชิงพื้นที่ 26 อำเภอ:</strong> บูรณาการผ่านคณะกรรมการพัฒนาคุณภาพชีวิตระดับอำเภอ (พชอ. Plus) และ Health Literacy Center (HLC)</li>
              <li><strong>โครงการเร่งรัดแนะนำ:</strong> <strong>${domain.project}</strong></li>
            </ul>
          </div>
        </div>

        <!-- Section E: Executive Decision Support -->
        <div class="executive-decision-box">
          <div class="executive-decision-header">
            <span>⚡ E. Executive Decision Support (ข้อเสนอเพื่อการตัดสินใจของผู้บริหาร)</span>
          </div>
          <div class="executive-decision-text">
            ${stat.probabilityOfAchievement >= 70 
              ? `"ผลการพยากรณ์อยู่ในเกณฑ์ On Track (${stat.probabilityOfAchievement}%) เสนอให้ผู้บริหารเห็นชอบให้ดำเนินการตามแผนงานปกติ และมอบหมายกลุ่มงานที่รับผิดชอบกำกับติดตามผลลัพธ์รายไตรมาสอย่างต่อเนื่อง"` 
              : `"ตัวชี้วัดมีความเสี่ยงที่จะไม่บรรลุเป้าหมาย (Forecast: ${stat.baseline} vs Target: ${stat.targetValue}) เสนอให้ผู้บริหารสั่งการ 'เร่งรัดมาตรการ Fast-Track' และจัดประชุม War Room ร่วมกับ 26 อำเภอภายใน 30 วัน"`
            }
          </div>
        </div>

      </div>

    </div>

    <!-- Footer -->
    <div class="modal-insight-footer">
      <div style="margin-right: auto; display: flex; gap: 0.5rem; align-items: center;">
        <span class="meta-pill">
          <span class="meta-pill-label">Engine:</span> <strong>${currentModel.model_name} (Auto Free Tier)</strong>
        </span>
        <span class="meta-pill">
          <span class="meta-pill-label">Target 69:</span> <strong>${kpi.target69 || '-'} ${kpi.unit}</strong>
        </span>
      </div>
      <button class="btn btn-secondary btn-sm" onclick="printOnePageLandscapeReport()" title="พิมพ์รายงาน One Page 16:9 แนวนอน 1 แผ่น">📑 พิมพ์รายงาน</button>
      <button class="btn-close-modal" onclick="closeAIPredictionFullscreenModal()">ปิดหน้าต่าง</button>
    </div>
  `;

  modal.classList.add('show');
  setTimeout(() => renderAIPredictionModalChart(kpi, stat, horizon), 60);
}

function renderAIPredictionModalChart(kpi, stat, horizon) {
  const canvas = document.getElementById('chart-ai-prediction-modal');
  if (!canvas) return;

  if (AppState.charts.aiPredictionModal) {
    AppState.charts.aiPredictionModal.destroy();
    AppState.charts.aiPredictionModal = null;
  }

  const ctx = canvas.getContext('2d');
  const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
  const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
  const textColor = isDark ? '#94a3b8' : '#64748b';
  const pointBorder = isDark ? '#0f172a' : '#ffffff';

  const labels = ['2566', '2567', '2568', '2569 (Forecast)', '2570 (เป้า)'];
  const a66 = extractNumber(kpi.actual66);
  const a67 = extractNumber(kpi.actual67);
  const a68 = extractNumber(kpi.actual68);

  const t66 = extractNumber(kpi.target66);
  const t67 = extractNumber(kpi.target67);
  const t68 = extractNumber(kpi.target68);
  const t69 = extractNumber(kpi.target69);
  const t70 = extractNumber(kpi.target70);

  const gradActual = ctx.createLinearGradient(0, 0, 0, 240);
  gradActual.addColorStop(0, 'rgba(13, 148, 136, 0.25)');
  gradActual.addColorStop(1, 'rgba(13, 148, 136, 0.01)');

  AppState.charts.aiPredictionModal = new Chart(canvas, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [
        {
          label: 'ผลงานจริง + Baseline Forecast',
          data: [a66, a67, a68, stat.baseline, null],
          borderColor: '#0d9488',
          borderWidth: 3.5,
          backgroundColor: gradActual,
          pointBackgroundColor: [
            getKPIPointColor(kpi, '66') || '#0d9488',
            getKPIPointColor(kpi, '67') || '#0d9488',
            getKPIPointColor(kpi, '68') || '#0d9488',
            stat.probabilityOfAchievement >= 70 ? '#10b981' : '#ef4444',
            '#0d9488'
          ],
          pointBorderColor: pointBorder,
          pointBorderWidth: 2.5,
          pointRadius: 7,
          pointHoverRadius: 10,
          fill: true,
          tension: 0.25
        },
        {
          label: 'Optimistic (+Intervention)',
          data: [null, null, a68, stat.optimistic, null],
          borderColor: '#10b981',
          borderDash: [3, 3],
          borderWidth: 2,
          pointBackgroundColor: '#10b981',
          pointBorderColor: pointBorder,
          pointRadius: 5,
          fill: false,
          tension: 0.15
        },
        {
          label: 'Pessimistic (Risk)',
          data: [null, null, a68, stat.pessimistic, null],
          borderColor: '#ef4444',
          borderDash: [3, 3],
          borderWidth: 2,
          pointBackgroundColor: '#ef4444',
          pointBorderColor: pointBorder,
          pointRadius: 5,
          fill: false,
          tension: 0.15
        },
        {
          label: 'เป้าหมายยุทธศาสตร์ (Target)',
          data: [t66, t67, t68, t69, t70],
          borderColor: '#94a3b8',
          borderDash: [6, 6],
          borderWidth: 2.5,
          pointBackgroundColor: '#94a3b8',
          pointBorderColor: pointBorder,
          pointRadius: 5,
          fill: false,
          tension: 0.1
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: { grid: { color: gridColor }, ticks: { color: textColor }, title: { display: true, text: kpi.unit || '', color: textColor } },
        x: { grid: { display: false }, ticks: { color: textColor } }
      },
      plugins: {
        legend: { display: false }
      }
    }
  });
}

function closeAIPredictionFullscreenModal() {
  const modal = document.getElementById('ai-prediction-fullscreen-modal');
  if (modal) modal.classList.remove('show');
}

function printOnePageLandscapeReport() {
  const aiModal = document.getElementById('ai-prediction-fullscreen-modal');
  const kpiModal = document.getElementById('kpi-detail-modal');

  let printClass = '';
  if (aiModal && aiModal.classList.contains('show')) {
    printClass = 'print-mode-ai-modal';
  } else if (kpiModal && kpiModal.classList.contains('show')) {
    printClass = 'print-mode-kpi-modal';
  }

  if (printClass) {
    document.body.classList.add(printClass);
  }

  setTimeout(() => {
    window.print();
    setTimeout(() => {
      if (printClass) {
        document.body.classList.remove(printClass);
      }
    }, 1200);
  }, 100);
}

function copyAIPredictionModalText(kpiId) {
  const el = document.getElementById(`ai-modal-brief-content-${kpiId}`);
  if (el) {
    navigator.clipboard.writeText(el.innerText).then(() => alert('คัดลอกบทวิเคราะห์และข้อเสนอเชิงบริหารเรียบร้อยแล้ว'));
  }
}

function copyAICenterResult() {
  const el = document.getElementById('ai-center-result-text');
  if (el) {
    navigator.clipboard.writeText(el.innerText).then(() => alert('คัดลอกผลการพยากรณ์และบทวิเคราะห์เรียบร้อยแล้ว'));
  }
}

// 15. Audit Log Modal Handlers
function openAuditLogModal() {
  const modal = document.getElementById('ai-audit-log-modal');
  const container = document.getElementById('ai-audit-log-table-container');
  if (!modal || !container) return;

  const logs = AIAuditLogger.getLogs();
  if (logs.length === 0) {
    container.innerHTML = `<div style="text-align:center; padding:2rem; color:var(--text-muted);">ยังไม่มีประวัติการพยากรณ์</div>`;
  } else {
    container.innerHTML = `
      <table class="audit-log-table">
        <thead>
          <tr>
            <th>เวลา</th>
            <th>รหัส KPI</th>
            <th>Model ID</th>
            <th>Forecast</th>
            <th>Confidence</th>
            <th>Risk</th>
          </tr>
        </thead>
        <tbody>
          ${logs.map(l => `
            <tr>
              <td>${new Date(l.timestamp).toLocaleTimeString('th-TH')}</td>
              <td><strong>${l.kpi_id}</strong></td>
              <td>${l.model_name || l.model_id}</td>
              <td>${l.prediction !== null ? l.prediction : '-'}</td>
              <td>${l.confidence}%</td>
              <td><span class="badge-status ${l.risk_level === 'LOW' ? 'pass' : l.risk_level === 'MODERATE' ? 'warn' : 'fail'}">${l.risk_level}</span></td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  modal.classList.add('show');
}

function closeAuditLogModal() {
  const modal = document.getElementById('ai-audit-log-modal');
  if (modal) modal.classList.remove('show');
}

function clearAuditLog() {
  if (confirm('ต้องการล้างประวัติ Audit Log ทั้งหมดหรือไม่?')) {
    AIAuditLogger.clear();
    openAuditLogModal();
  }
}

// 16. AI Model Catalog in Settings
function renderModelCatalog() {
  const container = document.getElementById('ai-model-catalog-container');
  if (!container) return;

  const models = GeminiModelManager.registry;
  const current = GeminiModelManager.getCurrentModel();

  container.innerHTML = models.map(m => `
    <div class="catalog-model-card ${m.model_id === current.model_id ? 'active-primary' : ''}">
      <div class="catalog-model-info">
        <div class="catalog-model-name">
          ${m.model_name} ${m.model_id === current.model_id ? '🌟 (Active Primary)' : ''}
        </div>
        <div class="catalog-model-tags">
          <span class="tag-free-tier">FREE TIER</span>
          <span>Gen: ${m.generation}</span>
          <span>Status: ${m.status}</span>
          <span>Score: ${m.score}/100</span>
        </div>
      </div>
      <div style="font-size:0.72rem; color:var(--text-muted); text-align:right;">
        ${m.recommended_for}
      </div>
    </div>
  `).join('');
}

async function checkGeminiModelUpdates() {
  const res = await GeminiModelManager.checkCatalogUpdates();
  updateAIStatusUI();
  renderModelCatalog();
  alert(`ตรวจสอบ Model Catalog เรียบร้อยแล้ว (สถานะ: ${res.status}, โมเดลปัจจุบัน: ${res.currentModel.model_name})`);
}

function updateAIModelSelectionMode(mode) {
  GeminiModelManager.config.mode = mode;
  GeminiModelManager.saveConfig();
  updateAIStatusUI();
}

