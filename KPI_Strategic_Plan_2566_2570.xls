    <Cell ss:StyleID="s63"><Data ss:Type="String">11.01</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">≥21</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">8.17</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ไม่บรรลุเป้าหมาย</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">กลุ่มงานการแพทย์แผนไทยและการแพทย์ทางเลือก</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="24">
