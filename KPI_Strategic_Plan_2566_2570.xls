    <Cell ss:StyleID="s64"><Data ss:Type="String">บุคลากรที่ปฏิบัติงานในระดับเครือข่ายบริการสุขภาพได้รับการพัฒนาสมรรถนะหลักและสมรรถนะรอง</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ร้อยละ</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยิ่งมากยิ่งดี</Data></Cell>
    <Cell ss:StyleID="s63"/>
    <Cell ss:StyleID="s63"><Data ss:Type="String">85</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String"></Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">รอเปิดรอบรายงาน</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">กลุ่มงานบริหารทรัพยากรบุคคล</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:StyleID="s63"><Data ss:Type="String">KPI70-33</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">33</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยุทธศาสตร์ที่ 4</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">เป้าประสงค์ที่ 7</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">ผลงานวิจัย/R2R/นวัตกรรมหรือเทคโนโลยีสุขภาพที่คิดค้นใหม่หรือที่พัฒนาต่อยอดนำไปแก้ไขปัญหาสาธารณสุขที่สำคัญของจังหวัดขอนแก่น</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">เรื่อง</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยิ่งมากยิ่งดี</Data></Cell>
    <Cell ss:StyleID="s63"/>
    <Cell ss:StyleID="s63"><Data ss:Type="String">วิจัย 450 / นวัตกรรม 120</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String"></Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">รอเปิดรอบรายงาน</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">กลุ่มงานพัฒนายุทธศาสตร์สาธารณสุข</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:StyleID="s63"><Data ss:Type="String">KPI70-34</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">34</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยุทธศาสตร์ที่ 4</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">เป้าประสงค์ที่ 7</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">จำนวนโรงพยาบาลสังกัดกระทรวงสาธารณสุขที่พัฒนาสู่องค์กรดิจิทัลและมีความมั่นคงปลอดภัยทางไซเบอร์</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">แห่ง</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยิ่งมากยิ่งดี</Data></Cell>
    <Cell ss:StyleID="s63"/>
