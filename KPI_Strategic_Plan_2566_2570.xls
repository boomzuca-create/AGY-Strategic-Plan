    <Cell ss:StyleID="s63"><Data ss:Type="String"></Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">รอเปิดรอบรายงาน</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">กลุ่มงานควบคุมโรคไม่ติดต่อ</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:StyleID="s63"><Data ss:Type="String">KPI70-13</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">13</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยุทธศาสตร์ที่ 1</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">เป้าประสงค์ที่ 2</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">ร้อยละของผู้ที่มีผลผิดปกติ (มะเร็งลำไส้ใหญ่และไส้ตรงผิดปกติ) ได้รับการส่องกล้อง Colonoscopy</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ร้อยละ</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยิ่งมากยิ่งดี</Data></Cell>
    <Cell ss:StyleID="s63"/>
    <Cell ss:StyleID="s63"><Data ss:Type="String">95</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String"></Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">รอเปิดรอบรายงาน</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">กลุ่มงานควบคุมโรคไม่ติดต่อ</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:StyleID="s63"><Data ss:Type="String">KPI70-14</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">14</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยุทธศาสตร์ที่ 1</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">เป้าประสงค์ที่ 2</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">อัตราความครอบคลุมของการค้นหาผู้ป่วยวัณโรคในกลุ่มผู้สัมผัสร่วมบ้านและผู้สัมผัสใกล้ชิด</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ร้อยละ</Data></Cell>
