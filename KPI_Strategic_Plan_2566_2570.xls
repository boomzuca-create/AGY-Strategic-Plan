   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:StyleID="s63"><Data ss:Type="String">KPI70-02</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">2</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยุทธศาสตร์ที่ 1</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">เป้าประสงค์ที่ 1</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">ระดับคะแนนความสำเร็จของอำเภอในการดำเนินงานความรอบรู้ด้านสุขภาพในการป้องกันโรค Stroke, Pneumonia และภาวะติดเชื้อในกระแสเลือด</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">คะแนน</Data></Cell>
