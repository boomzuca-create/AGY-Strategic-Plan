   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:StyleID="s63"><Data ss:Type="String">KPI70-25</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">25</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยุทธศาสตร์ที่ 2</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">เป้าประสงค์ที่ 4</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">ร้อยละของผู้ป่วยที่มีการวินิจฉัยโรคหลอดเลือดสมอง อัมพฤกษ์ อัมพาต ระยะกลาง (Intermediate Care) ที่ได้รับการดูแลด้วยการแพทย์แผนไทยและการแพทย์ทางเลือก</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ร้อยละ</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยิ่งมากยิ่งดี</Data></Cell>
    <Cell ss:StyleID="s63"/>
    <Cell ss:StyleID="s63"><Data ss:Type="String">≥24</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String"></Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">รอเปิดรอบรายงาน</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">กลุ่มงานการแพทย์แผนไทยและการแพทย์ทางเลือก</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:StyleID="s63"><Data ss:Type="String">KPI70-26</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">26</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยุทธศาสตร์ที่ 2</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">เป้าประสงค์ที่ 4</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">ร้อยละผู้ป่วยนอกที่ได้รับบริการ ตรวจ วินิจฉัย รักษาโรค และฟื้นฟูสภาพ ด้วยศาสตร์การแพทย์แผนไทยและการแพทย์ทางเลือก</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ร้อยละ</Data></Cell>
