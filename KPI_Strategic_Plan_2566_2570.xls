    <Cell ss:StyleID="s64"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:StyleID="s63"><Data ss:Type="String">KPI70-12</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">12</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยุทธศาสตร์ที่ 1</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">เป้าประสงค์ที่ 2</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">ร้อยละของประชาชนอายุ 50-70 ปี (รายใหม่) กลุ่มเป้าหมายได้รับการคัดกรองมะเร็ง ลำไส้ใหญ่/ไส้ตรง ด้วยวิธี FIT Test</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ร้อยละ</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยิ่งมากยิ่งดี</Data></Cell>
    <Cell ss:StyleID="s63"/>
