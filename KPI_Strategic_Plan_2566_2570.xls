   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:StyleID="s63"><Data ss:Type="String">KPI70-30</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">30</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยุทธศาสตร์ที่ 2</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">เป้าประสงค์ที่ 5</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">ร้อยละของการให้บริการผู้ป่วยนอกด้วยระบบด้วยระบบการแพทย์ทางไกล (Telemedicine) ในหน่วยบริการปฐมภูมิ</Data></Cell>
