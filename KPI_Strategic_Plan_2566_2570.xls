   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:StyleID="s63"><Data ss:Type="String">KPI70-11</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">11</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ยุทธศาสตร์ที่ 1</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">เป้าประสงค์ที่ 2</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">ร้อยละสตรีอายุ 30-60 ปี กลุ่มเป้าหมายได้รับการคัดกรองมะเร็งปากมดลูกด้วยวิธี HPV DNA (สะสมผลงาน 2568-2570 ≥ 80%)</Data></Cell>
